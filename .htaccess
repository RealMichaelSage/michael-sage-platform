RewriteEngine On
RewriteBase /

# --- 301 Redirects for Legacy Tilda URLs & Phantoms ---
RewriteRule ^work/sd/?$ /solutions/ [R=301,L]
RewriteRule ^work/sb/?$ / [R=301,L]
RewriteRule ^page[0-9]+\.html$ / [R=301,L]
RewriteRule ^33333333/?$ / [R=301,L]
RewriteRule ^mod-cursor-1/?$ / [R=301,L]
RewriteRule ^mockup/?$ / [R=301,L]
RewriteRule ^videomod/?$ / [R=301,L]
RewriteRule ^savage2/?$ / [R=301,L]
RewriteRule ^mod11/?$ / [R=301,L]
RewriteRule ^tpost/.*$ / [R=301,L]
RewriteRule ^tproduct/.*$ / [R=301,L]
RewriteRule ^project/.*$ / [R=301,L]
RewriteRule ^bjhb/?$ / [R=301,L]
RewriteRule ^skript-peredachi-utm-metok-tilda-telegram/?$ /automation [R=301,L]
RewriteRule ^generator_utm_metok_dlya_telegram/?$ /automation [R=301,L]
RewriteRule ^proccalc/?$ /calculators [R=301,L]
RewriteRule ^unitcalc/?$ /calculators [R=301,L]
RewriteRule ^dc1/?$ /automation [R=301,L]

# Rewrite requests to .html files without extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Custom Error Documents
ErrorDocument 404 /index.html

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
